package ui

templ BaseLayout(section string, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/dashboard">autochess companion</a>
				<nav aria-label="primary">
					<a class={ templ.KV("navlink", true), templ.KV("navlink-active", section == "dashboard") } href="/dashboard">dashboard</a>
					<a class={ templ.KV("navlink", true), templ.KV("navlink-active", section == "matches") } href="/matches">matches</a>
					<a class={ templ.KV("navlink", true), templ.KV("navlink-active", section == "codex") } href="/heroes">codex</a>
				</nav>
			</header>
			<main class="content">
				if section == "codex" {
					<nav class="tabs" aria-label="codex">
						for _, t := range codexTabs(title) {
							<a class={ templ.KV("tab", true), templ.KV("tab-active", t.Active) } href={ t.Href }>{ t.Label }</a>
						}
					</nav>
				}
				@content
			</main>
			<script src="/static/focus.js" defer></script>
		</body>
	</html>
}
