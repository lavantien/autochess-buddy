package ui

import (
	"github.com/lavantien/autochess-buddy/internal/domain"
	"github.com/lavantien/autochess-buddy/internal/store/sqlite"
)

// MatchesListPage renders the matches table with its plain GET filters.
templ MatchesListPage(rows []sqlite.MatchListRow, f sqlite.MatchFilter, patches []domain.Patch) {
	@BaseLayout("matches", "matches", matchesBody(rows, f, patches))
}

templ matchesBody(rows []sqlite.MatchListRow, f sqlite.MatchFilter, patches []domain.Patch) {
	<section class="matches">
		<div class="listhead">
			<h1>matches</h1>
			<a class="button button-primary" href="/matches/new">new match</a>
		</div>
		<form class="filterrow" method="get" action="/matches">
			<label>
				<span>patch</span>
				<select name="patch">
					<option value="">all</option>
					for _, p := range patches {
						<option value={ p.Version } selected?={ f.PatchID == p.ID }>{ p.Version }</option>
					}
				</select>
			</label>
			<label>
				<span>source</span>
				<select name="source">
					<option value="">all</option>
					<option value="pro" selected?={ f.Source == "pro" }>pro</option>
					<option value="me" selected?={ f.Source == "me" }>me</option>
				</select>
			</label>
			<label>
				<span>state</span>
				<select name="state">
					<option value="">all</option>
					<option value="draft" selected?={ f.State == "draft" }>draft</option>
					<option value="final" selected?={ f.State == "final" }>final</option>
				</select>
			</label>
			<button type="submit" class="button button-quiet">apply</button>
		</form>
		if len(rows) == 0 {
			@EmptyState("no matches yet. start one from the game you just finished.", nil)
		} else {
			<table>
				<thead><tr><th>state</th><th>played</th><th>patch</th><th>source</th><th>lineups</th><th>notes</th></tr></thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>{ matchState(r.Match) }</td>
							<td><a href={ matchHref(r.Match) }>{ playedText(r.Match.PlayedAt) }</a></td>
							<td>{ r.PatchVersion }</td>
							<td>{ r.Match.Source }</td>
							<td>
								<a href={ matchHref(r.Match) }>
									@Pips(r.LineupCount, requiredTotal(r.Match.Source))
								</a>
							</td>
							<td>{ r.Match.Notes }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

func matchState(m domain.Match) string {
	if m.FinalizedAt > 0 {
		return "final"
	}
	return "draft"
}

func matchHref(m domain.Match) string {
	if m.FinalizedAt > 0 {
		return "/matches/" + itoa(m.ID)
	}
	return "/matches/" + itoa(m.ID) + "/edit"
}

// NewMatchPage renders the create shell form.
templ NewMatchPage(patches []domain.Patch, st CodexFormState) {
	@BaseLayout("matches", "new match", newMatchBody(patches, st))
}

templ newMatchBody(patches []domain.Patch, st CodexFormState) {
	<section class="matches">
		<h1>new match</h1>
		<form method="post" action="/matches/new" class="stack codexform">
			<label>
				<span>patch</span>
				<select name="patch_id">
					for _, p := range patches {
						<option value={ itoa(p.ID) } selected?={ st.val("patch_id", "") == itoa(p.ID) }>{ p.Version }</option>
					}
				</select>
			</label>
			<label>
				<span>source</span>
				<select name="source">
					<option value="pro" selected?={ st.val("source", "") == "pro" }>pro</option>
					<option value="me" selected?={ st.val("source", "") == "me" }>me</option>
				</select>
			</label>
			<label>
				<span>played at</span>
				<input type="datetime-local" name="played_at" value={ st.val("played_at", "") } data-autofocus?={ st.autofocus("played_at") }/>
				if msg := st.err("played_at"); msg != "" {
					<p class="fielderr">{ msg }</p>
				}
			</label>
			<label>
				<span>notes</span>
				<input type="text" name="notes" value={ st.val("notes", "") }/>
			</label>
			<button type="submit" class="button button-primary">create match</button>
		</form>
	</section>
}

// MatchDetailPage renders the scoreboard strip and the read-only boards.
templ MatchDetailPage(m domain.Match, patchVersion string, lineups []domain.Lineup) {
	@BaseLayout("matches", "match", detailBody(m, patchVersion, lineups))
}

templ detailBody(m domain.Match, patchVersion string, lineups []domain.Lineup) {
	<section class="detail">
		<h1>match { itoa(m.ID) }</h1>
		<p class="meta">patch { patchVersion } { m.Source } finalized { playedText(m.FinalizedAt) }</p>
		<div class="scorestrip">
			for _, l := range lineups {
				<div class="scorecard">
					@PlacementNumeral(l.Placement)
					<span class="who">{ lineupName(l) }</span>
					<span class="record">{ l.Wins }-{ l.Draws }-{ l.Losses }</span>
					<span class="record">{ l.Networth }nw</span>
				</div>
			}
		</div>
		<div class="cards readonly">
			for _, l := range lineups {
				@ReadOnlyCard(l)
			}
		</div>
		<p class="notes">{ m.Notes }</p>
	</section>
}

func lineupName(l domain.Lineup) string {
	if l.Label != "" {
		return l.Label
	}
	return "board " + itoa(int64(l.Placement))
}

// ReadOnlyCard renders one finalized board without any form controls.
templ ReadOnlyCard(l domain.Lineup) {
	<article class="lcard">
		<header class="lcard-head">
			@PlacementNumeral(l.Placement)
			<span class="who">{ lineupName(l) }</span>
		</header>
		<p class="record">w-d-l { l.Wins }-{ l.Draws }-{ l.Losses } networth { l.Networth }</p>
		<div class="relics">
			<span class="rowlabel">relics</span>
			<div class="chips">
				for _, r := range l.Relics {
					@Chip(r.Name, nil)
				}
			</div>
		</div>
		<div class="grid">
			for i := 0; i < 12; i++ {
				if sl := slotAt(l, i); sl != nil {
					<div class="slot">
						<span class="slot-top">@RarityDot(sl.Hero.Cost)<span class="slot-name">{ sl.Hero.Name }</span></span>
						@StarPips(sl.Stars)
						<div class="chips">
							for _, it := range sl.Items {
								@Chip(it.Name, nil)
							}
						</div>
					</div>
				} else {
					<div class="slot slot-empty" aria-hidden="true"></div>
				}
			}
		</div>
	</article>
}
