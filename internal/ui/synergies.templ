package ui

import "github.com/lavantien/autochess-buddy/internal/domain"

// LadderEntry is one race or class with its tier ladder for the synergies tab.
type LadderEntry struct {
	ID    int64
	Name  string
	Tiers []domain.Tier
}

// SynergiesPage manages races and classes with their tier ladders.
templ SynergiesPage(races, classes []LadderEntry, st CodexFormState) {
	@BaseLayout("codex", "races", synergiesBody(races, classes, st))
}

templ synergiesBody(races, classes []LadderEntry, st CodexFormState) {
	<div class="synergy-cols">
		<section>
			<h1>races</h1>
			<details class="disclosure">
				<summary>+ new race</summary>
				<form method="post" action="/races" class="stack codexform">
					<label><span>name</span><input type="text" name="name" value={ st.val("races-name", "") } data-autofocus?={ st.autofocus("races-name") }/></label>
					if msg := st.err("races-name"); msg != "" {
						<p class="fielderr">{ msg }</p>
					}
					<button type="submit" class="button button-primary">save race</button>
				</form>
			</details>
			if len(races) == 0 {
				@EmptyState(CodexEmpty("races"), nil)
			}
			for _, rc := range races {
				@LadderEditor("races", rc, st)
			}
		</section>
		<section>
			<h1>classes</h1>
			<details class="disclosure">
				<summary>+ new class</summary>
				<form method="post" action="/classes" class="stack codexform">
					<label><span>name</span><input type="text" name="name" value={ st.val("classes-name", "") } data-autofocus?={ st.autofocus("classes-name") }/></label>
					if msg := st.err("classes-name"); msg != "" {
						<p class="fielderr">{ msg }</p>
					}
					<button type="submit" class="button button-primary">save class</button>
				</form>
			</details>
			if len(classes) == 0 {
				@EmptyState(CodexEmpty("classes"), nil)
			}
			for _, cl := range classes {
				@LadderEditor("classes", cl, st)
			}
		</section>
	</div>
}

// LadderEditor renders one race or class with its tier rows and per-tier forms.
templ LadderEditor(entity string, e LadderEntry, st CodexFormState) {
	<div class="ladder">
		<form method="post" action={ "/" + entity + "/" + itoa(e.ID) } class="inline-form">
			<input type="hidden" name="mode" value="save_name"/>
			<input type="text" name="name" value={ st.val(LadderKey(entity, e.ID, "name"), e.Name) } data-autofocus?={ st.autofocus(LadderKey(entity, e.ID, "name")) } aria-label="name"/>
			<button type="submit" class="button button-quiet" hx-disable="this">save { entity }</button>
			if msg := st.err(LadderKey(entity, e.ID, "name")); msg != "" {
				<p class="fielderr">{ msg }</p>
			}
		</form>
		<table>
			<thead><tr><th>count</th><th>effect</th></tr></thead>
			<tbody>
				for _, t := range e.Tiers {
					<tr>
						<td>{ t.Count }</td>
						<td>{ t.Effect }</td>
						<td class="rowactions">
							<form method="post" action={ "/" + entity + "/" + itoa(e.ID) } class="inline-form">
								<input type="hidden" name="mode" value="delete_tier"/>
								<input type="hidden" name="count" value={ itoa(int64(t.Count)) }/>
								<button type="submit" class="button button-quiet">delete tier</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<form method="post" action={ "/" + entity + "/" + itoa(e.ID) } class="inline-form tier-add">
			<input type="hidden" name="mode" value="save_tier"/>
			<input type="number" name="count" min="1" placeholder="count" value={ st.val(LadderKey(entity, e.ID, "tier-count"), "") } aria-label="count"/>
			<input type="text" name="effect" placeholder="effect" value={ st.val(LadderKey(entity, e.ID, "tier-effect"), "") } aria-label="effect"/>
			<button type="submit" class="button button-primary">save tier</button>
			if msg := st.err(LadderKey(entity, e.ID, "tier")); msg != "" {
				<p class="fielderr">{ msg }</p>
			}
		</form>
		@CodexDeleteForm(codexSingular[entity], e.ID, e.Name)
	</div>
}
