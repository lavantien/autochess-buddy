package ui

import (
	"github.com/lavantien/autochess-buddy/internal/domain"
	"github.com/lavantien/autochess-buddy/internal/store/sqlite"
)

// HeroesPage renders the heroes index with the create disclosure and the
// read-only analytics columns.
templ HeroesPage(rows []sqlite.HeroStats, races []domain.Race, classes []domain.Class, st CodexFormState) {
	@BaseLayout("codex", "heroes", heroesBody(rows, races, classes, st))
}

templ heroesBody(rows []sqlite.HeroStats, races []domain.Race, classes []domain.Class, st CodexFormState) {
	<h1>heroes</h1>
	<details class="disclosure">
		<summary>+ new hero</summary>
		@HeroFields(races, classes, st, 0, "save hero")
	</details>
	if len(rows) == 0 {
		@EmptyState(CodexEmpty("heroes"), nil)
	} else {
		<table>
			<thead><tr><th>name</th><th>cost</th><th>races</th><th>classes</th><th>lineups</th><th>avg place</th></tr></thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td><a href={ "/heroes/" + itoa(r.Hero.ID) }>{ r.Hero.Name }</a></td>
						<td>@RarityDot(r.Hero.Cost)<span class="cost">{ r.Hero.Cost }</span></td>
						<td>{ lineageNames(r.Hero.Races) }</td>
						<td>{ lineageNamesC(r.Hero.Classes) }</td>
						<td>{ itoa(int64(r.Lineups)) }</td>
						<td>{ avgText(r.AvgPlace) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// HeroEditPage renders one hero's edit form plus delete.
templ HeroEditPage(h domain.Hero, races []domain.Race, classes []domain.Class, st CodexFormState, conflict string) {
	@BaseLayout("codex", "heroes", heroEditBody(h, races, classes, st, conflict))
}

templ heroEditBody(h domain.Hero, races []domain.Race, classes []domain.Class, st CodexFormState, conflict string) {
	<h1>{ h.Name }</h1>
	if conflict != "" {
		<p class="banner" role="alert">{ conflict }</p>
	}
	@HeroFields(races, classes, st, h.ID, "save hero")
	@CodexDeleteForm("hero", h.ID, h.Name)
}

// HeroFields renders the hero fields; id 0 means create.
templ HeroFields(races []domain.Race, classes []domain.Class, st CodexFormState, id int64, submit string) {
	<form method="post" action={ heroAction(id) } class="stack codexform">
		<label>
			<span>name</span>
			<input type="text" name="name" value={ st.val("name", "") } data-autofocus?={ st.autofocus("name") }/>
			if msg := st.err("name"); msg != "" {
				<p class="fielderr">{ msg }</p>
			}
		</label>
		<label>
			<span>cost</span>
			<input type="number" name="cost" min="1" max="5" value={ st.val("cost", "1") } data-autofocus?={ st.autofocus("cost") }/>
			if msg := st.err("cost"); msg != "" {
				<p class="fielderr">{ msg }</p>
			}
		</label>
		<label>
			<span>race 1</span>
			<select name="race1">
				<option value="">none</option>
				for _, rc := range races {
					<option value={ itoa(rc.ID) } selected?={ st.val("race1", "") == itoa(rc.ID) }>{ rc.Name }</option>
				}
			</select>
		</label>
		<label>
			<span>race 2</span>
			<select name="race2">
				<option value="">none</option>
				for _, rc := range races {
					<option value={ itoa(rc.ID) } selected?={ st.val("race2", "") == itoa(rc.ID) }>{ rc.Name }</option>
				}
			</select>
		</label>
		<label>
			<span>class 1</span>
			<select name="class1">
				<option value="">none</option>
				for _, cl := range classes {
					<option value={ itoa(cl.ID) } selected?={ st.val("class1", "") == itoa(cl.ID) }>{ cl.Name }</option>
				}
			</select>
		</label>
		<label>
			<span>class 2</span>
			<select name="class2">
				<option value="">none</option>
				for _, cl := range classes {
					<option value={ itoa(cl.ID) } selected?={ st.val("class2", "") == itoa(cl.ID) }>{ cl.Name }</option>
				}
			</select>
		</label>
		if msg := st.err("lineage"); msg != "" {
			<p class="fielderr">{ msg }</p>
		}
		<label>
			<span>ability</span>
			<input type="text" name="ability" value={ st.val("ability", "") }/>
		</label>
		<label>
			<span>notes</span>
			<input type="text" name="notes" value={ st.val("notes", "") }/>
		</label>
		<button type="submit" class="button button-primary">{ submit }</button>
	</form>
}

// ItemsPage renders the item index and create form.
templ ItemsPage(items []domain.Item, st CodexFormState) {
	@BaseLayout("codex", "items", itemsBody(items, st))
}

templ itemsBody(items []domain.Item, st CodexFormState) {
	<h1>items</h1>
	<details class="disclosure">
		<summary>+ new item</summary>
		@ItemForm(items, st, 0, "save item")
	</details>
	if len(items) == 0 {
		@EmptyState(CodexEmpty("items"), nil)
	} else {
		<table>
			<thead><tr><th>name</th><th>tier</th><th>effect</th></tr></thead>
			<tbody>
				for _, it := range items {
					<tr>
						<td><a href={ "/items/" + itoa(it.ID) }>{ it.Name }</a></td>
						<td>{ itoa(int64(it.Tier)) }</td>
						<td>{ it.Effect }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ ItemEditPage(it domain.Item, all []domain.Item, st CodexFormState, conflict string) {
	@BaseLayout("codex", "items", itemEditBody(it, all, st, conflict))
}

templ itemEditBody(it domain.Item, all []domain.Item, st CodexFormState, conflict string) {
	<h1>{ it.Name }</h1>
	if conflict != "" {
		<p class="banner" role="alert">{ conflict }</p>
	}
	@ItemForm(all, st, it.ID, "save item")
	@CodexDeleteForm("item", it.ID, it.Name)
}

// ItemForm renders the item fields including the recipe multi-select; selected
// components arrive as preselected options.
templ ItemForm(all []domain.Item, st CodexFormState, id int64, submit string) {
	<form method="post" action={ itemAction(id) } class="stack codexform">
		<label>
			<span>name</span>
			<input type="text" name="name" value={ st.val("name", "") } data-autofocus?={ st.autofocus("name") }/>
			if msg := st.err("name"); msg != "" {
				<p class="fielderr">{ msg }</p>
			}
		</label>
		<label>
			<span>tier</span>
			<input type="number" name="tier" min="1" value={ st.val("tier", "1") }/>
		</label>
		<label>
			<span>effect</span>
			<input type="text" name="effect" value={ st.val("effect", "") }/>
		</label>
		<label>
			<span>components</span>
			<select name="components" multiple size="4">
				for _, opt := range all {
					<option value={ itoa(opt.ID) } selected?={ st.hasComponent(opt.ID) }>{ opt.Name }</option>
				}
			</select>
		</label>
		<button type="submit" class="button button-primary">{ submit }</button>
	</form>
}

