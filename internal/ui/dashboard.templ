package ui

import (
	"github.com/lavantien/autochess-buddy/internal/analytics"
	"github.com/lavantien/autochess-buddy/internal/domain"
)

// DashboardPage renders the full overview for one view with its filter row.
templ DashboardPage(view string, patches []domain.Patch, patchVersion string, f analytics.Filter, panel templ.Component, n int) {
	@BaseLayout("dashboard", "dashboard", dashBody(view, patches, patchVersion, f, panel, n))
}

templ dashBody(view string, patches []domain.Patch, patchVersion string, f analytics.Filter, panel templ.Component, n int) {
	<section class="dash">
		<form class="filterrow" method="get" action={ "/dashboard/" + view }>
			<label>
				<span>patch</span>
				<select name="patch"
					hx-get={ "/dashboard/" + view }
					hx-target={ "#dashpanel-" + view }
					hx-include="closest form"
					hx-push-url="true"
					hx-sync="this:abort"
					hx-trigger="change"
				>
					<option value="">all</option>
					for _, p := range patches {
						<option value={ p.Version } selected={ patchVersion == p.Version }>{ p.Version }</option>
					}
				</select>
			</label>
			<label>
				<span>source</span>
				<select name="source"
					hx-get={ "/dashboard/" + view }
					hx-target={ "#dashpanel-" + view }
					hx-include="closest form"
					hx-push-url="true"
					hx-sync="this:abort"
					hx-trigger="change"
				>
					<option value="">all</option>
					<option value="pro" selected={ f.Source == "pro" }>pro</option>
					<option value="me" selected={ f.Source == "me" }>me</option>
				</select>
			</label>
			<span class="viewn">{ n } lineups in view</span>
		</form>
		<nav class="tabs" aria-label="dashboard">
			for _, v := range dashViews {
				<a class={ templ.KV("tab", true), templ.KV("tab-active", v == view) } href={ "/dashboard/" + v }>{ v }</a>
			}
		</nav>
		@MetricLegend()
		@panel
	</section>
}

// DashPanel wraps one view's table in the stable swap target.
templ DashPanel(view string, table templ.Component) {
	<div id={ "dashpanel-" + view }>
		@table
	</div>
}

// HeroTable renders hero performance rows with the networth curve pinned under
// it, closing the readme metric list (frontend-design:124).
templ HeroTable(rows []analytics.HeroRow, places []analytics.PlaceRow) {
	if len(rows) == 0 {
		@EmptyState("no finalized matches for this filter yet. finalize a few matches first.", nil)
	} else {
		<h2>hero performance</h2>
		<table>
			<thead><tr><th>hero</th><th>cost</th><th>pick</th><th>top 4</th><th>floor</th><th>avg</th><th>vs field</th><th>finishes</th></tr></thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>@RarityDot(r.Hero.Cost)<span class="slot-name">{ r.Hero.Name }</span></td>
						<td>{ num(float64(r.Hero.Cost)) }</td>
						<td>{ pct(r.PickRate) }</td>
						<td>{ pct(r.Top4Rate) }</td>
						<td>{ pct(r.Floor) }</td>
						<td>{ num(r.AvgPlace) }</td>
						<td>{ signed(r.VsField) }</td>
						<td>@SpreadBar(r.Finishes)</td>
					</tr>
				}
			</tbody>
		</table>
		@NetworthTable(places)
	}
}

// NetworthTable is the compact placement curve at the dashboard bottom.
templ NetworthTable(places []analytics.PlaceRow) {
	if len(places) > 0 {
		<h2>networth by placement</h2>
		<table>
			<thead><tr><th>place</th><th>avg networth</th><th>n</th></tr></thead>
			<tbody>
				for _, p := range places {
					<tr>
						<td>{ itoa(int64(p.Placement)) }</td>
						<td>{ num(p.AvgNetworth) }</td>
						<td>{ itoa(int64(p.N)) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// SynergyTable renders one row per (synergy, tier).
templ SynergyTable(rows []analytics.SynergyRow) {
	if len(rows) == 0 {
		@EmptyState("no finalized matches for this filter yet. finalize a few matches first.", nil)
	} else {
		<h2>synergy lift</h2>
		<table>
			<thead><tr><th>synergy</th><th>tier</th><th>lineups</th><th>lift</th><th>finishes</th></tr></thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>{ r.Name }</td>
						<td>{ itoa(int64(r.TierCount)) }</td>
						<td>{ itoa(int64(r.Lineups)) }</td>
						<td>{ signed(r.Lift) }</td>
						<td>@SpreadBar(r.Finishes)</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

