package ui

import (
	"fmt"
	"strconv"
)

templ Button(kind string, label string) {
	<button type="submit" class={ templ.KV("button", true), templ.KV("button-"+kind, true) }>{ label }</button>
}

templ Pips(filled int, total int) {
	<span class="pips">
		for i := 0; i < total; i++ {
			<span class={ templ.KV("pip", true), templ.KV("pip-full", i < filled) }></span>
		}
		<span class="pip-count">{ fmt.Sprintf("%d/%d", filled, total) }</span>
	</span>
}

templ StarPips(stars int) {
	<span class="stars">
		for i := 0; i < 3; i++ {
			<span class={ templ.KV("star", true), templ.KV("star-full", i < stars) }></span>
		}
		<span class="star-count">{ fmt.Sprintf("%d/3", stars) }</span>
	</span>
}

templ PlacementNumeral(placement int) {
	<span class={ templ.Class("numeral " + placeClass(placement)) }>{ strconv.Itoa(placement) }</span>
}

templ RarityDot(cost int) {
	<span class={ templ.Class("dot " + costClass(cost)) } aria-hidden="true"></span>
}

templ Chip(label string, remove templ.Component) {
	<span class="chip">
		<span class="chip-label">{ label }</span>
		if remove != nil {
			@remove
		}
	</span>
}

templ SpreadBar(shares [8]int) {
	<span class="spread" role="img" aria-label={ spreadLabel(shares) }>
		for i, s := range shares {
			if s > 0 {
				<span class={ templ.Class("spread-seg " + spreadTier(i+1)) } style={ templ.SafeCSS("width:" + spreadWidth(shares, i)) }></span>
			}
		}
	</span>
}

templ MetricLegend() {
	<dl class="legend">
		for _, e := range legendEntries {
			<dt>{ e[0] }</dt>
			<dd>{ e[1] }</dd>
		}
	</dl>
}

templ EmptyState(message string, action templ.Component) {
	<div class="empty">
		<p>{ message }</p>
		if action != nil {
			@action
		}
	</div>
}
