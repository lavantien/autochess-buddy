package ui

import (
	"github.com/lavantien/autochess-buddy/internal/domain"
	"github.com/lavantien/autochess-buddy/internal/service"
)

templ EditorPage(view service.EditorView, banner string) {
	@BaseLayout("matches", "edit match", editorBody(view, banner))
}

templ editorBody(view service.EditorView, banner string) {
	<section class="editor">
		<div class="editor-head">
			<h1>edit match</h1>
			<span class="meta">patch { view.PatchVersion } source { view.Match.Source }</span>
			@PipsRegion(view, false)
			<form method="post" action={ "/matches/" + itoa(view.Match.ID) + "/finalize" }>
				<button type="submit" class="button button-primary">finalize match</button>
			</form>
		</div>
		if banner != "" {
			<p class="banner" role="alert">{ banner }</p>
		}
		@CardsRegion(view, ResetAddForm(view), false)
	</section>
}

templ PipsRegion(view service.EditorView, oob bool) {
	<span
		id={ "pips-" + itoa(view.Match.ID) }
		class="pipswrap"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		@Pips(len(view.Lineups), requiredTotal(view.Match.Source))
	</span>
}

templ CardsRegion(view service.EditorView, addState AddFormState, oob bool) {
	<div
		id={ "cards-" + itoa(view.Match.ID) }
		class="cards"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		for _, l := range view.Lineups {
			@LineupCard(view, l, EditFormState{Placement: itoa(int64(l.Placement)), ProID: proIDText(l), Label: l.Label, Wins: itoa(int64(l.Wins)), Draws: itoa(int64(l.Draws)), Losses: itoa(int64(l.Losses)), Networth: itoa(int64(l.Networth))}, HeroFormState{Reset: true}, SlotFormState{}, RelicState{}, "")
		}
		@AddForm(view, addState, false)
	</div>
}

templ AddForm(view service.EditorView, st AddFormState, oob bool) {
	<form
		id={ "addform-" + itoa(view.Match.ID) }
		class="lcard addform stack"
		if oob {
			hx-swap-oob="outerHTML"
		}
		hx-post={ "/matches/" + itoa(view.Match.ID) + "/lineups" }
		hx-swap="none"
		hx-sync="this:abort"
	>
		<h2>add lineup</h2>
		<label>
			<span>placement</span>
			<input type="number" name="placement" min="1" max="8" value={ st.Placement } data-autofocus={ st.firstErrField() == "placement" || st.firstErrField() == "" }/>
		</label>
		<label>
			<span>pro</span>
			<select name="pro">
				<option value="" selected={ st.ProID == "" }>none</option>
				for _, p := range view.Pros {
					<option value={ itoa(p.ID) } selected={ st.ProID == itoa(p.ID) }>{ p.Name }</option>
				}
			</select>
		</label>
		<label>
			<span>label</span>
			<input type="text" name="label" value={ st.Label }/>
		</label>
		<div class="scalars">
			<label><span>w</span><input type="number" name="wins" min="0" value={ st.Wins }/></label>
			<label><span>d</span><input type="number" name="draws" min="0" value={ st.Draws }/></label>
			<label><span>l</span><input type="number" name="losses" min="0" value={ st.Losses }/></label>
			<label><span>nw</span><input type="number" name="networth" min="0" value={ st.Networth }/></label>
		</div>
		if msg := st.err("placement"); msg != "" {
			<p class="fielderr">{ msg }</p>
		}
		if msg := st.err("record"); msg != "" {
			<p class="fielderr">{ msg }</p>
		}
		<button type="submit" class="button button-primary" hx-disable="this">add lineup</button>
	</form>
}

templ LineupCard(view service.EditorView, l domain.Lineup, editState EditFormState, heroState HeroFormState, slotState SlotFormState, relicState RelicState, copyErr string) {
	<article id={ "card-" + itoa(l.ID) } class="lcard">
		<header class="lcard-head">
			@PlacementNumeral(l.Placement)
			<span class="who">{ displayName(view, l) }</span>
			if peak := peakLabel(view, l); peak != "" {
				<span class="peak">{ peak }</span>
			}
			<details class="disclosure">
				<summary>edit</summary>
				@EditForm(view, l, editState, false)
			</details>
		</header>
		<p class="record">w-d-l { l.Wins }-{ l.Draws }-{ l.Losses } networth { l.Networth }</p>
		@RelicsRegion(view, l, relicState, false)
		@GridRegion(view, l, slotState, false)
		@HeroForm(view, l, heroState, false)
		<footer class="lcard-foot">
			<form
				class="inline-form"
				hx-post={ "/matches/" + itoa(view.Match.ID) + "/lineups" }
				hx-swap="none"
				hx-sync="this:abort"
			>
				<input type="hidden" name="copy_from" value={ itoa(l.ID) }/>
				<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
				<button type="submit" class="button button-quiet" hx-disable="this">copy</button>
				if copyErr != "" {
					<span class="fielderr">{ copyErr }</span>
				}
			</form>
			<form
				class="inline-form"
				hx-delete={ "/lineups/" + itoa(l.ID) + "?match_id=" + itoa(view.Match.ID) }
				hx-swap="none"
				hx-confirm="delete this lineup? its heroes and items go with it."
				hx-sync="this:abort"
				hx-on:htmx:before:swap="window.__acNext=this.closest('.lcard').querySelector('button, input, select, summary')"
			>
				<button type="submit" class="button button-destructive" hx-disable="this">delete</button>
			</form>
		</footer>
	</article>
}

func proIDText(l domain.Lineup) string {
	if l.ProID == nil {
		return ""
	}
	return itoa(*l.ProID)
}

templ EditForm(view service.EditorView, l domain.Lineup, st EditFormState, oob bool) {
	<form
		id={ "editform-" + itoa(l.ID) }
		class="stack"
		if oob {
			hx-swap-oob="outerHTML"
		}
		hx-post={ "/lineups/" + itoa(l.ID) }
		hx-swap="none"
		hx-sync="this:abort"
	>
		<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
		<label>
			<span>placement</span>
			<input type="number" name="placement" min="1" max="8" value={ st.Placement } data-autofocus={ st.firstErrField() == "placement" }/>
		</label>
		<label>
			<span>pro</span>
			<select name="pro">
				<option value="" selected={ st.ProID == "" }>none</option>
				for _, p := range view.Pros {
					<option value={ itoa(p.ID) } selected={ st.ProID == itoa(p.ID) }>{ p.Name }</option>
				}
			</select>
		</label>
		<label>
			<span>label</span>
			<input type="text" name="label" value={ st.Label }/>
		</label>
		<div class="scalars">
			<label><span>w</span><input type="number" name="wins" min="0" value={ st.Wins }/></label>
			<label><span>d</span><input type="number" name="draws" min="0" value={ st.Draws }/></label>
			<label><span>l</span><input type="number" name="losses" min="0" value={ st.Losses }/></label>
			<label><span>nw</span><input type="number" name="networth" min="0" value={ st.Networth }/></label>
		</div>
		if msg := st.err("placement"); msg != "" {
			<p class="fielderr">{ msg }</p>
		}
		<button type="submit" class="button button-primary" hx-disable="this">save lineup</button>
	</form>
}

templ GridRegion(view service.EditorView, l domain.Lineup, st SlotFormState, oob bool) {
	<div
		id={ "grid-" + itoa(l.ID) }
		class="grid"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		for i := 0; i < 12; i++ {
			if sl := slotAt(l, i); sl != nil {
				@SlotCell(view, l, *sl, st)
			} else {
				<div class="slot slot-empty" aria-hidden="true"></div>
			}
		}
	</div>
}

templ SlotCell(view service.EditorView, l domain.Lineup, sl domain.Slot, st SlotFormState) {
	<div id={ "slot-" + itoa(sl.ID) } class="slot">
		<span class="slot-top">@RarityDot(sl.Hero.Cost)
<span class="slot-name">{ sl.Hero.Name }</span></span>
		@StarPips(sl.Stars)
		<div class="chips">
			for _, it := range sl.Items {
				@Chip(it.Name, removeItemForm(view, l.ID, sl.ID, it.ID))
			}
		</div>
		<details class="disclosure" open={ st.OpenSlotID == sl.ID }>
			<summary>slot details</summary>
			<form
				class="stack"
				hx-post={ "/slots/" + itoa(sl.ID) }
				hx-swap="none"
				hx-sync="this:abort"
			>
				<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
				<label>
					<span>stars</span>
					<select name="stars" data-autofocus={ st.BadSlotID == sl.ID && st.BadField == "stars" }>
						for s := 1; s <= 3; s++ {
							<option value={ itoa(int64(s)) } selected={ s == sl.Stars }>{ s }</option>
						}
					</select>
				</label>
				<button type="submit" class="button button-quiet" hx-disable="this">save stars</button>
				if st.BadSlotID == sl.ID && st.BadField == "stars" {
					<p class="fielderr">{ st.BadMsg }</p>
				}
			</form>
			<form
				class="stack"
				hx-post={ "/slots/" + itoa(sl.ID) + "/items" }
				hx-swap="none"
				hx-sync="this:abort"
			>
				<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
				<label>
					<span>item</span>
					<select name="item" data-autofocus={ st.BadSlotID == sl.ID && st.BadField == "item" }>
						for _, it := range view.Items {
							<option value={ itoa(it.ID) }>{ it.Name }</option>
						}
					</select>
				</label>
				<button type="submit" class="button button-quiet" hx-disable="this">add item</button>
				if st.BadSlotID == sl.ID && st.BadField == "item" {
					<p class="fielderr">{ st.BadMsg }</p>
				}
			</form>
		</details>
	</div>
}

templ removeItemForm(view service.EditorView, lineupID, slotID, itemID int64) {
	<form
		class="chip-x"
		hx-delete={ "/slots/" + itoa(slotID) + "/items/" + itoa(itemID) + "?match_id=" + itoa(view.Match.ID) }
		hx-swap="none"
		hx-sync="this:abort"
	>
		<button type="submit" aria-label="remove item" hx-disable="this">×</button>
	</form>
}

templ HeroForm(view service.EditorView, l domain.Lineup, st HeroFormState, oob bool) {
	<form
		id={ "heroform-" + itoa(l.ID) }
		class="heroform"
		if oob {
			hx-swap-oob="outerHTML"
		}
		hx-post={ "/lineups/" + itoa(l.ID) + "/slots" }
		hx-swap="none"
		hx-sync="this:abort"
	>
		<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
		<input
			type="text"
			name="hero"
			list={ "herolist-" + itoa(l.ID) }
			placeholder="type a hero name"
			value={ st.Hero }
			data-autofocus={ st.Reset || st.Err != "" }
			autocomplete="off"
		/>
		<datalist id={ "herolist-" + itoa(l.ID) }>
			for _, h := range view.Heroes {
				<option value={ h.Name }></option>
			}
		</datalist>
		<label>
			<span>stars</span>
			<select name="stars">
				for s := 1; s <= 3; s++ {
					<option value={ itoa(int64(s)) } selected={ (st.Stars == "" && s == 2) || st.Stars == itoa(int64(s)) }>{ s }</option>
				}
			</select>
		</label>
		<button type="submit" class="button button-primary" hx-disable="this">add hero</button>
		if st.Err != "" {
			<p class="fielderr">{ st.Err }</p>
		}
	</form>
}

templ RelicsRegion(view service.EditorView, l domain.Lineup, st RelicState, oob bool) {
	<div
		id={ "relics-" + itoa(l.ID) }
		class="relics"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		<span class="rowlabel">relics</span>
		<div class="chips">
			for _, r := range l.Relics {
				@Chip(r.Name, removeRelicForm(view, l.ID, r.ID))
			}
		</div>
		<details class="disclosure" open={ st.Open }>
			<summary>add relic</summary>
			<form
				class="stack"
				hx-post={ "/lineups/" + itoa(l.ID) + "/relics" }
				hx-swap="none"
				hx-sync="this:abort"
			>
				<input type="hidden" name="match_id" value={ itoa(view.Match.ID) }/>
				<label>
					<span>relic</span>
					<select name="relic" data-autofocus={ st.Err != "" }>
						for _, r := range view.Relics {
							<option value={ itoa(r.ID) }>{ r.Name }</option>
						}
					</select>
				</label>
				<button type="submit" class="button button-quiet" hx-disable="this">add relic</button>
				if st.Err != "" {
					<p class="fielderr">{ st.Err }</p>
				}
			</form>
		</details>
	</div>
}

templ removeRelicForm(view service.EditorView, lineupID, relicID int64) {
	<form
		class="chip-x"
		hx-delete={ "/lineups/" + itoa(lineupID) + "/relics/" + itoa(relicID) + "?match_id=" + itoa(view.Match.ID) }
		hx-swap="none"
		hx-sync="this:abort"
	>
		<button type="submit" aria-label="remove relic" hx-disable="this">×</button>
	</form>
}
